{
  "name": "@hacienda/plugin-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/registry.js",
  "types": "./dist/registry.d.ts",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "prevalidate": "npm run build",
    "validate": "node dist/validate-plugin.js",
    "predocs": "npm run build",
    "docs": "node dist/generate-docs.js",
    "precreate": "npm run build",
    "create": "node dist/create-plugin.js",
    "preadd-skill": "npm run build",
    "add-skill": "node dist/add-skill.js",
    "preadd-agent": "npm run build",
    "add-agent": "node dist/add-agent.js",
    "precompare-claude-legal": "npm run build",
    "compare-claude-legal": "node dist/compare-with-reference.js",
    "preanno-dist": "npm run build",
    "prepackage-cowork": "npm run build",
    "package-cowork": "node dist/package-plugin.js"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  },
  "license": "AGPL-3.0-or-later"
}
