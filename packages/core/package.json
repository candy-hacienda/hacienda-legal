{
  "name": "@hacienda/core",
  "version": "0.1.0",
  "description": "Core library partagé par les plugins de la suite Hacienda (client PISTE OAuth, cache SQLite, schémas Zod, tools Légifrance).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "undici": "^7.0.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "author": "Hacienda (https://hacienda.diy)",
  "license": "AGPL-3.0-or-later",
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.60.2"
  }
}
